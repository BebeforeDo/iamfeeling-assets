  <div class="nav-inner">
    <a href="https://iamfeeling.com" class="nav-logo">
      <img src="https://iamfeeling.com/logo.png" alt="iamfeeling™">
    </a>
    <div class="nav-right">對頻・限場次使用</div>
  </div>
</nav>
<div id="app">

  <!-- GATE -->
  <div class="screen active" id="gate">
    <div class="gate">
      <div class="gate-eyebrow">對頻 · 拼貼素材</div>
      <div class="gate-title">請輸入今天的通行碼</div>
      <div class="gate-sub">這個頁面只給今天在場的人。<br>通行碼由現場口頭或聊天室提供。</div>
      <input class="gate-input" id="gateInput" type="text" inputmode="latin" autocomplete="off" placeholder="通行碼" onkeydown="if(event.key==='Enter')checkGate()">
      <button class="btn-go" style="margin-top:1.1rem" onclick="checkGate()">進入</button>
      <div class="gate-error" id="gateError"></div>
    </div>
  </div>

  <!-- S0: START -->
  <div class="screen" id="s0">
    <div class="hd">
      <div class="hd-eyebrow">對頻 · 拼貼素材</div>
      <div class="hd-title">抽一張畫</div>
    </div>
    <div class="prompt">不用挑。<br>抽到的，就是今天的材料。</div>
    <div class="prompt-sub">不限次數。抽到有感覺的就留下，<br>沒感覺的就再抽一次，繼續往下走。</div>
    <div class="breath-zone"><div class="breath-orb"></div></div>
    <button class="btn-go" onclick="drawCard()">抽畫</button>
  </div>

  <!-- S1: CARD -->
  <div class="screen" id="s1">
    <div class="card-wrap" id="cardWrap">
      <div class="card-frame"><img id="cardImg" src="" alt=""></div>
      <div class="card-credit" id="cardCredit"></div>
      <div class="card-count" id="cardCount"></div>
    </div>
    <a class="btn-go" id="openBtn" href="#" target="_blank" rel="noopener" style="display:block;text-align:center;text-decoration:none;box-sizing:border-box">開啟原圖（存檔用）</a>
    <button class="btn-ghost" onclick="drawCard()">再抽一張</button>

    <div class="collected" id="collectedWrap" style="display:none">
      <div class="collected-label">這次抽過的畫</div>
      <div class="collected-grid" id="collectedGrid"></div>
    </div>
  </div>

  <div class="footer">
    <div class="footer-line">素材抽完了，記得帶著它去 Canva 拼貼。<br>對頻 · iamfeeling™ · © 2026 BeDo LLC</div>
  </div>
</div>
<script>
/* ── 通行碼：每次對頻前手動更改這一行 ── */
const PASSCODE = "0723";

function checkGate(){
  const val = document.getElementById("gateInput").value.trim();
  const err = document.getElementById("gateError");
  if(val === PASSCODE){
    document.getElementById("gate").classList.remove("active");
    document.getElementById("s0").classList.add("active");
  } else {
    err.textContent = "通行碼不對，再確認一次。";
  }
}

