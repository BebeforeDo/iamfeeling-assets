/* ── 抽取邏輯:避免連續重複 + 記錄本場次抽過的畫 ── */
let recentIndices = [];
const RECENT_AVOID_COUNT = 5;
let drawnThisSession = [];  // {img, credit}
let drawCount = 0;

function drawCard(){
  let idx = Math.floor(Math.random() * ARTWORKS.length);
  let attempts = 0;
  while(recentIndices.includes(idx) && attempts < ARTWORKS.length){
    idx = (idx + 1) % ARTWORKS.length;
    attempts++;
  }
  recentIndices.push(idx);
  if(recentIndices.length > RECENT_AVOID_COUNT) recentIndices.shift();

  const art = ARTWORKS[idx];
  drawCount++;
  drawnThisSession.push(art);

  document.getElementById("cardImg").src = art.img;
  document.getElementById("cardCredit").textContent = art.credit;
  document.getElementById("cardCount").textContent = "第 " + drawCount + " 張";
  document.getElementById("openBtn").href = art.img;

  document.getElementById("s0").classList.remove("active");
  document.getElementById("s1").classList.add("active");
  const wrap = document.getElementById("cardWrap");
  wrap.style.animation = "none";
  requestAnimationFrame(()=>{ wrap.style.animation = "rise .6s ease forwards"; });

  renderCollected();
}

function renderCollected(){
  if(drawnThisSession.length < 2) return;
  const wrap = document.getElementById("collectedWrap");
  const grid = document.getElementById("collectedGrid");
  wrap.style.display = "block";
  grid.innerHTML = "";
  drawnThisSession.forEach(art=>{
    const im = document.createElement("img");
    im.src = art.img;
    im.title = art.credit;
    im.onclick = ()=>{
      document.getElementById("cardImg").src = art.img;
      document.getElementById("cardCredit").textContent = art.credit;
      document.getElementById("openBtn").href = art.img;
      window.scrollTo({top:0, behavior:"smooth"});
    };
    grid.appendChild(im);
  });
}
