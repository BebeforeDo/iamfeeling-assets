<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Cormorant Garamond',serif;background:#0c0c0a;color:#e8e4dc;min-height:100vh}
.nav{position:sticky;top:0;z-index:100;background:#fafaf8;border-bottom:0.5px solid #e0e0d8;}
.nav-inner{max-width:900px;margin:0 auto;padding:0 1.25rem;height:52px;display:flex;align-items:center;justify-content:space-between;}
.nav-logo{display:flex;align-items:center;text-decoration:none;}
.nav-logo img{width:44px;height:44px;object-fit:contain;}
.nav-right{font-family:'Noto Sans',sans-serif;font-size:12px;color:#999992;letter-spacing:.04em;}
#app{max-width:460px;margin:0 auto;padding:0 1.25rem 5rem}

/* ---- gate screen ---- */
.gate{padding-top:3.5rem;text-align:center}
.gate-eyebrow{font-family:'Noto Sans',sans-serif;font-size:.65rem;letter-spacing:.24em;color:rgba(232,228,220,.4);margin-bottom:1.4rem;text-transform:uppercase}
.gate-title{font-size:2rem;font-weight:300;line-height:1.3;margin-bottom:1.6rem}
.gate-sub{font-family:'Noto Sans',sans-serif;font-size:.85rem;color:rgba(232,228,220,.5);line-height:1.9;margin-bottom:2.5rem}
.gate-input{width:100%;font-family:'Noto Sans',sans-serif;font-size:1rem;letter-spacing:.08em;text-align:center;padding:.95rem;border:.5px solid rgba(255,255,255,.22);background:transparent;color:#e8e4dc;border-radius:4px;-webkit-appearance:none;appearance:none;outline:none}
.gate-input:focus{border-color:rgba(255,220,100,.5)}
.gate-error{font-family:'Noto Sans',sans-serif;font-size:.78rem;color:rgba(255,140,120,.75);margin-top:.85rem;min-height:1.2em}

/* ---- shared ---- */
.hd{text-align:center;padding:2.5rem 0 1rem}
.hd-eyebrow{font-family:'Noto Sans',sans-serif;font-size:.65rem;letter-spacing:.24em;color:rgba(232,228,220,.4);margin-bottom:1.1rem;text-transform:uppercase}
.hd-title{font-size:2rem;font-weight:300;line-height:1.25;color:#e8e4dc}
.screen{display:none}
.screen.active{display:block}
.prompt{font-size:1.25rem;font-weight:300;font-style:italic;line-height:1.75;color:#e8e4dc;text-align:center;margin:1.75rem 0 1rem}
.prompt-sub{font-family:'Noto Sans',sans-serif;font-size:.85rem;color:rgba(232,228,220,.5);line-height:1.95;text-align:center;margin-bottom:2.5rem}
.breath-zone{display:flex;justify-content:center;margin-bottom:2.25rem}
.breath-orb{width:96px;height:96px;border-radius:50%;background:radial-gradient(circle at 38% 36%,rgba(200,169,110,.55),rgba(200,169,110,.08) 65%,transparent);animation:breathe 10s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:scale(.62);opacity:.45}50%{transform:scale(1);opacity:.9}}
@media(prefers-reduced-motion:reduce){.breath-orb{animation:none;transform:scale(.85)}}
.btn-go{font-family:inherit;font-size:1.05rem;width:100%;padding:1.1rem;border:none;background:#c8a96e;color:#12100b;cursor:pointer;border-radius:4px;-webkit-appearance:none;appearance:none;transition:opacity .15s;font-weight:500}
.btn-go:active{opacity:.82}
.btn-ghost{font-family:inherit;font-size:.95rem;width:100%;padding:.95rem;border:.5px solid rgba(255,255,255,.22);background:transparent;color:rgba(232,228,220,.7);cursor:pointer;border-radius:4px;-webkit-appearance:none;appearance:none;margin-top:.85rem}
.btn-ghost:active{border-color:rgba(255,255,255,.45)}
.btn-text{font-family:'Noto Sans',sans-serif;font-size:.78rem;letter-spacing:.06em;color:rgba(232,228,220,.4);background:none;border:none;cursor:pointer;padding:.5rem;text-decoration:underline;text-underline-offset:3px;display:block;margin:1.25rem auto 0}

/* ---- card ---- */
.card-wrap{opacity:0;transform:translateY(8px);animation:rise .6s ease forwards}
@keyframes rise{to{opacity:1;transform:translateY(0)}}
.card-frame{position:relative;width:100%;max-height:60vh;border-radius:6px;overflow:hidden;background:#111;border:.5px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center}
.card-frame img{width:100%;max-height:60vh;object-fit:contain;display:block}
.card-credit{font-family:'Noto Sans',sans-serif;font-size:.72rem;letter-spacing:.05em;color:rgba(232,228,220,.4);text-align:center;margin-top:1rem;font-style:italic}
.card-count{font-family:'Noto Sans',sans-serif;font-size:.68rem;letter-spacing:.14em;color:rgba(232,228,220,.32);text-align:center;text-transform:uppercase;margin-top:.5rem}

/* ---- collected strip ---- */
.collected{margin-top:2.5rem}
.collected-label{font-family:'Noto Sans',sans-serif;font-size:.68rem;letter-spacing:.14em;color:rgba(232,228,220,.35);text-transform:uppercase;margin-bottom:.85rem;text-align:center}
.collected-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem}
.collected-grid img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:3px;opacity:.75;cursor:pointer;transition:opacity .15s;border:.5px solid rgba(255,255,255,.06)}
.collected-grid img:hover,.collected-grid img:active{opacity:1}

.footer{text-align:center;padding:2.5rem 0 1rem;border-top:.5px solid rgba(255,255,255,.06);margin-top:2.5rem}
.footer-line{font-family:'Noto Sans',sans-serif;font-size:.7rem;letter-spacing:.05em;color:rgba(232,228,220,.3);line-height:1.9}
.footer a{color:rgba(200,169,110,.55);text-decoration:none}
</style>
